# Supabase: Project Settings → API (or Connect dialog in dashboard).
# Often the same project as Galaxy / Guard Allowance — copy from another app’s `.env.local`.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Use either the publishable key (new) or anon key (legacy) — one is enough
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required for server-side Supabase Storage uploads on `/admin/email-signatures`.
# Use the service role key from Project Settings > API. Keep this server-only.
# SUPABASE_SERVICE_ROLE_KEY=

# Drizzle: Project Settings → Database → Connection string (URI).
# Prefer the "Transaction" pooler URL for serverless; use `?sslmode=require` if needed.
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Required in production — public URL of this deployment (e.g. https://panda-realty.vercel.app).
# Used as the base for admin links in portal notification emails (upload / message alerts sent to the agent).
# Without this, links in those emails fall back to new URL(request.url).origin, which is correct on Vercel
# but can be wrong if the app sits behind a proxy that rewrites the host. Set it explicitly in production.
# NEXT_PUBLIC_APP_URL=https://panda-realty.vercel.app

# Optional — postgres.js pool size (default 10). Lower if you hit Supabase connection limits.
# DATABASE_POOL_MAX=10

# Optional — Playwright: signed-in cases in `e2e/home.spec.ts`. Same E2E_ADMIN_* as other apps.
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=

# Optional — `e2e/admin-properties-latest-buyer-offers.live.spec.ts` row IDs (defaults in spec if unset).
# E2E_PANDA_LATEST_OFFERS_PROPERTY_ID=
# E2E_PANDA_LATEST_OFFERS_BUYER_JUNCTION_ID=
# E2E_PANDA_LATEST_OFFERS_CLEANUP_ENTITY_ID=

# Optional — `e2e/successful-buyer-member-names.spec.ts` row IDs + search terms (defaults in spec if unset).
# E2E_PANDA_SUCCESSFUL_BUYER_MULTI_PROPERTY_ID=
# E2E_PANDA_SUCCESSFUL_BUYER_MULTI_SEARCH=
# E2E_PANDA_SUCCESSFUL_BUYER_SINGLE_PROPERTY_ID=
# E2E_PANDA_SUCCESSFUL_BUYER_SINGLE_SEARCH=

# Optional — E2E DB helpers (`apps/panda-realty/e2e/scripts/`). Require DATABASE_URL above.
# Playwright `e2e/global-setup.ts`: seeds fixtures when DATABASE_URL is set (idempotent) AND saves admin
# session state to `e2e/.auth/admin.json` when E2E_ADMIN_EMAIL/PASSWORD are set (used by storageState in
# playwright.config.ts so each test starts with a pre-loaded session cookie — avoids per-test login timeouts).
# npm run e2e:seed:sellers-accepted -w panda-realty   — same seed; run manually if you test without loading globalSetup
# node ./e2e/scripts/apply-condition-notes-column.mjs   — add buyer_offers.condition_notes if migration not applied

# Optional — Playwright (see `docs/CI.md` and `.agents/skills/galaxy-testing/SKILL.md`). Defaults match this app’s `playwright.config.ts`.
# PLAYWRIGHT_BASE_URL=          # default http://localhost:3004 unless set
# PLAYWRIGHT_FULLSCREEN=1
# PLAYWRIGHT_HEADLESS=1
# PLAYWRIGHT_WORKERS=1
# PLAYWRIGHT_HEADED=1

# Google OAuth — for Gmail inbox lead import (Admin → Properties).
# Create at console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID.
# Add this redirect URI to the client: http://localhost:3004/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3004/api/auth/google/callback

# OpenRouter — powers the LLM-backed business name / contact search in the Add Contact dialog.
# Calls `anthropic/claude-haiku-4.5:online` (Claude Haiku with Exa web search) to find Australian
# businesses by name and return name/phone/email/address/suburb/state/postcode. Replaced the
# previous Google Places integration so businesses without a Google Business Profile are still
# findable from a normal web search.
# Sign up at https://openrouter.ai → Settings → Keys → Create Key. Top up credits ($5 minimum,
# pay-as-you-go). Roughly $0.005–0.01 per search.
# OPENROUTER_API_KEY=

# Optional — dev only (`NODE_ENV=development`): limit **Sync contacts** (`patch-all`) to listings /
# property–entity links touched in the last N hours so manual Google testing finishes quickly.
# Use a small value (e.g. 1–6) for quick checks; large values still pull a lot of rows.
# Leave unset for a full sync. Response includes `devRecentFilterHours` when active.
# PANDA_GOOGLE_CONTACTS_PATCH_ALL_RECENT_HOURS=6
#
# Optional — dev only: comma-separated **`property_list_id`** values. Restricts bulk fetch to those
# listings only (owners + property-linked entities). Combines with **`RECENT_HOURS`** when both are set (AND).
# Response includes **`devPropertyListIdAllowlist`** when active.
# PANDA_GOOGLE_CONTACTS_PATCH_ALL_PROPERTY_LIST_IDS=

# Dev (`NODE_ENV=development`): each **Sync contacts** overwrites a trace file (gitignored):
# `apps/panda-realty/.scratch/google-contacts-patch-all.log.txt` — see JSON `devPatchAllLogRelativePath` when present.
# GOOGLE_CONTACTS_PATCH_ALL_DEV_LOG=true

# Vercel Cron — protects /api/cron/* routes. Generate any random secret and set the same
# value in Vercel Dashboard → Project Settings → Environment Variables.
# CRON_SECRET=

# Dev server: port 3004 (`npm run dev -w panda-realty`).

# Optional — public app URL used as the base for offer-form links sent to buyers.
# Defaults to the request origin at runtime if unset (works for local dev; set in production).
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# Property meetings / reminders — wall-clock for scheduling is fixed in code as Australia/Brisbane
# (`MEETING_SCHEDULE_TIMEZONE` in `apps/panda-realty/lib/meeting-scheduled-at.ts`). No env override yet.

# ── Adobe Sign (Phase 3 — e-signature) ──────────────────────────────────────
# Webhook auth token — REQUIRED in production.
# Append ?token=<value> to the URL registered with Adobe Sign so only Adobe's
# own POST requests (which include the token in the URL you provided at registration)
# are accepted. Generate with: openssl rand -hex 32
# ADOBE_SIGN_WEBHOOK_TOKEN=
# Richard's account (applications@mypandarealty.com.au) is on Creative Cloud Pro with Sign integrated
# into DC Web — the classic OAuth app admin is inaccessible. Auth uses IMS implicit flow (prompt=none)
# with EchoSign2 client + long-lived IMS session cookies captured via Playwright.
# When the session expires (typically weeks), re-run Playwright against acrobat.adobe.com to refresh.
# ADOBE_SIGN_BASE_URL=https://api.au1.documents.adobe.com/api/rest/v6
# ADOBE_SIGN_IMS_SID=          # ims_sid cookie from .services.adobe.com (long-lived session ID)
# ADOBE_SIGN_IMS_SESSION=      # s_ims cookie value (IMS session URL from .adobe.com)
# ADOBE_SIGN_FG=               # fg fingerprint cookie from .adobe.com

# Mock mode — bypasses all real Adobe Sign / IMS API calls; returns deterministic fake responses.
# Set to "true" in E2E / CI environments so tests never touch Richard's live account.
# ADOBE_SIGN_TEST_MODE=true

# Sandbox mode — when "true", uses sandbox credentials instead of Richard's production account.
# Obtain sandbox credentials from a free Adobe Sign developer account (adobesign.com/developer).
# ADOBE_SIGN_USE_SANDBOX=true
# ADOBE_SIGN_SANDBOX_BASE_URL=https://api.na1.adobesign.com/api/rest/v6
# ADOBE_SIGN_SANDBOX_IMS_SID=  # ims_sid cookie from sandbox account

# ── Backup scripts (apps/panda-realty/tools/) ────────────────────────────────
# Use the DIRECT connection (port 5432), NOT the pooler (port 6543).
# Find it in: Supabase dashboard → Project Settings → Database → "Direct connection".
# SOURCE_DATABASE_URL=postgresql://postgres.<ref>:<pw>@db.<ref>.supabase.co:5432/postgres
# CLIENT_DATABASE_URL=postgresql://postgres.<client-ref>:<client-pw>@db.<client-ref>.supabase.co:5432/postgres
